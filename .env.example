# Copiar a .env (no se versiona) y completar.

# SQL Server exige: 8+ caracteres con mayusculas, minusculas, numeros y simbolos.
MSSQL_SA_PASSWORD=CambiarEsta_Clave123!

# Clave de firma JWT: 32+ bytes aleatorios. Generar, por ejemplo, con:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SIGNING_KEY=

# Opcionales: sin ellas la IA cae al adaptador por reglas.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Origen del frontend permitido por CORS.
CORS_ORIGIN=http://localhost:5173
